# ==============================================================================
# Onyx Audio — Environment Configuration
# ==============================================================================
# NOTE: The app runs 100% out of the box with zero configuration required!
# All values below are OPTIONAL fallbacks or platform overrides.
# ==============================================================================

# Public App URL (used for OpenGraph and metadataBase)
NEXT_PUBLIC_APP_URL=https://onyx-player.vercel.app

# (Optional) YouTube Data API v3 Key
# Used as secondary fallback if YouTube InnerTube scraper quota or IP is throttled.
YOUTUBE_DATA_API_KEY=

# (Optional) Spotify Developer Credentials
# Used as fallback for Spotify playlist extraction if standard web scraping fails.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# (Optional) Set to 'true' if building a self-hosted Docker standalone container
# OUTPUT_STANDALONE=false
